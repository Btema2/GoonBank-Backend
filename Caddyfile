{
    # Disable port 80 HTTP-to-HTTPS redirect since port 80 is taken
    auto_https disable_redirects
}

# Listen on port 443 for any incoming host/IP (e.g. https://localhost or https://<school-ip>)
:443 {
    # Generate an internal self-signed TLS certificate (no domain or Let's Encrypt required)
    tls internal

    reverse_proxy goonbank-api:8000
}
